{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"resources/**/*.{ts,svelte,scss}\" \"*.config.{js,ts}\" \"svelte.config.js\"",
        "format:check": "prettier --check \"resources/**/*.{ts,svelte,scss}\" \"*.config.{js,ts}\" \"svelte.config.js\"",
        "check": "svelte-check --tsconfig ./tsconfig.json"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.9.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.11.0",
        "jiti": "^2.7.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "sass-embedded": "^1.103.1",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/svelte": "^3.7.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "svelte": "^5.56.10",
        "svelte-check": "^4.7.6",
        "typescript": "^5.9.3"
    }
}
