{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "build": "vite build && vite build --ssr",
        "dev": "vite",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"resources/**/*.{ts,svelte,scss}\" \"*.config.{js,ts}\" \"svelte.config.js\"",
        "format:check": "prettier --check \"resources/**/*.{ts,svelte,scss}\" \"*.config.{js,ts}\" \"svelte.config.js\"",
        "check": "svelte-check --tsconfig ./tsconfig.json --config ./svelte.config.js && tsc --noEmit -p tsconfig.node.json"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.4.1",
        "concurrently": "10.0.5",
        "eslint": "10.9.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-svelte": "3.23.0",
        "globals": "17.12.0",
        "jiti": "2.7.0",
        "laravel-vite-plugin": "3.2.0",
        "prettier": "3.9.6",
        "prettier-plugin-svelte": "4.1.1",
        "sass-embedded": "1.103.1",
        "typescript-eslint": "8.69.0",
        "vite": "8.2.2"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "0.4.3"
    },
    "dependencies": {
        "@inertiajs/svelte": "3.7.0",
        "@inertiajs/vite": "3.7.0",
        "@sentry/svelte": "10.73.0",
        "@sveltejs/vite-plugin-svelte": "7.3.0",
        "svelte": "5.57.0",
        "svelte-check": "4.7.6",
        "typescript": "5.9.3"
    }
}
