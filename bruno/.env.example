# Copy to bruno/.env, which is gitignored. Nothing in that file is ever committed.
#
# Read these in .bru files as {{process.env.NAME}}, never by putting the value in an
# environment file, so a secret cannot reach a commit by accident.
#
# Both tokens are empty for now: no request needs one until authentication exists.
USER_API_TOKEN=
ADMIN_API_TOKEN=

# Staging sits behind Cloudflare Access. This is the service-token pair, the same values
# CI uses to reach it.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
