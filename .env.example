APP_NAME=syoksheet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL="https://syoksheet.ddev.site"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION="pgsql"
DB_HOST="db"
DB_PORT="5432"
DB_DATABASE="db"
DB_USERNAME="db"
DB_PASSWORD="db"

# Audit database: the `log` connection, a separate Postgres instance.
# Inert until Phase 1 defines the connection in config/database.php.
LOG_DB_HOST=postgres-audit
LOG_DB_PORT=5432
LOG_DB_DATABASE=syoksheet_audit
LOG_DB_USERNAME=db
LOG_DB_PASSWORD=db
LOG_DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.syoksheet.ddev.site
# Phase 1: uncomment once a `session` redis connection exists in config/database.php.
# Setting this now breaks every request: the connection is undefined.
# SESSION_CONNECTION=session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
# Phase 1: uncomment once a `queue` redis connection exists, so queues land on DB 3.
# REDIS_QUEUE_CONNECTION=queue

MAIL_MAILER="smtp"
MAIL_SCHEME=null
MAIL_HOST=buggregator
MAIL_PORT="1025"
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@syoksheet.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage: MinIO stands in for Cloudflare R2 locally.
# Inert until Phase 1 defines the `r2_public` and `r2_private` disks in
# config/filesystems.php, which today has only local, public and s3.
R2_ACCESS_KEY_ID=ddevminio
R2_SECRET_ACCESS_KEY=ddevminio
R2_ENDPOINT=http://minio:10101
R2_PUBLIC_BUCKET=syoksheet-public-local
R2_PRIVATE_BUCKET=syoksheet-private-local
R2_PUBLIC_URL=https://syoksheet.ddev.site:10101/syoksheet-public-local
# Phase 1: switch to `r2_private` once those disks exist.
# FILESYSTEM_DISK=r2_private

BOOST_RULES_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
VITE_SENTRY_DSN=https://sentry@buggregator.syoksheet.ddev.site/1
SENTRY_ENVIRONMENT=local
SENTRY_LARAVEL_DSN=http://sentry@buggregator:8000/1
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=1.0
