APP_NAME=syoksheet
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Fallback root for URLs built outside a request: queued jobs, console, mail. Not a
# per-domain setting. The apex serves the public domain; app./admin. links are
# built explicitly against DOMAIN_APP and DOMAIN_ADMIN below.
APP_URL="https://syoksheet.ddev.site"

# The four hosts Route::domain() groups match on. No fallbacks anywhere: an unset
# value would mean "no host constraint", serving every domain on every hostname.
DOMAIN_APP=app.syoksheet.ddev.site
DOMAIN_ADMIN=admin.syoksheet.ddev.site
DOMAIN_API=api.syoksheet.ddev.site
DOMAIN_PUBLIC=syoksheet.ddev.site

# Server-side rendering runs on the apex alone; app. and admin. opt out in their
# middleware. Locally it is served by `npm run dev`. With Vite not running, apex pages
# fall back to client-side rendering and still return 200, which is why a refused
# connection is not reported to Sentry in this environment.
INERTIA_SSR_ENABLED=true
# Loopback only. The port must match vite.config.ts; change one without the other and
# SSR stops silently, with only a Sentry message to show for it.
INERTIA_SSR_URL=http://127.0.0.1:13714

# Cache-Control on apex GET responses, read by Cloudflare. Only the apex is cacheable,
# because it is the only domain that shares no user data. stale-while-revalidate keeps
# the renderer off the critical path; stale-if-error covers an SSR or origin outage.
PUBLIC_CACHE_MAX_AGE=60
PUBLIC_CACHE_STALE_WHILE_REVALIDATE=300
PUBLIC_CACHE_STALE_IF_ERROR=86400

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Two databases on one instance. The audit database is a separate database, never a
# schema: Postgres cannot foreign-key across databases, which is what keeps audit
# references as raw IDs.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=syoksheet_primary
DB_USERNAME=db
DB_PASSWORD=db

AUDIT_DB_HOST=db
AUDIT_DB_PORT=5432
AUDIT_DB_DATABASE=syoksheet_audit
AUDIT_DB_USERNAME=db
AUDIT_DB_PASSWORD=db
AUDIT_DB_SSLMODE=prefer

# Host-only session cookie, deliberately not a leading-dot parent domain. Only app.
# and admin. hold a session, they run separate guards, and neither needs the other's
# cookie. A parent-domain cookie would also be sent to api., which is bearer-token
# only, and to the apex, which is public, stateless and cached: a session identifier
# has no business on a cacheable surface, and its presence is a common cause of CDN
# cache bypass. Guard separation is enforced by guards, never by cookie scope.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=r2_private
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# One Redis instance, split by role. The split is for clarity, not safety: eviction
# policy is per instance, so `volatile-lru` in redis.conf is what protects the queue.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_QUEUE_CONNECTION=queue

# Buggregator, not DDEV's Mailpit. Nothing local ever reaches a real address.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=buggregator
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@syoksheet.com"
MAIL_FROM_NAME="${APP_NAME}"

# RustFS stands in for Cloudflare R2. The endpoint is container-internal on 9000;
# the public URL is the host-reachable one a browser uses.
R2_ACCESS_KEY_ID=rustfsadmin
R2_SECRET_ACCESS_KEY=rustfsadmin
R2_ENDPOINT=http://rustfs:9000
R2_PUBLIC_BUCKET=syoksheet-public-local
R2_PRIVATE_BUCKET=syoksheet-private-local
R2_PUBLIC_URL=https://syoksheet.ddev.site:9000/syoksheet-public-local

# Two DSNs for one Buggregator: the backend reaches it over the Docker network, the
# browser through the router. Same protocol, different hosts.
SENTRY_ENVIRONMENT=local
SENTRY_LARAVEL_DSN=http://sentry@buggregator:8000/1
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=1.0

VITE_APP_NAME="${APP_NAME}"
VITE_SENTRY_DSN=https://sentry@buggregator.syoksheet.ddev.site/1

# Laravel AI SDK. Anthropic is the only provider we configure; the SDK ships many more
# and they stay unconfigured on purpose.
#
# AI runs in queued jobs only, never in a web request, and only ever sees public
# taxonomy data or org-authored job text. Leave the key empty locally: with no key an
# agent call fails and the queued job retries, so a missing key delays the review queue
# and breaks nothing a user can see.
#
# Model choice lives on each agent via the SDK's #[Model] attribute, not here.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

BOOST_RULES_ENABLED=true
